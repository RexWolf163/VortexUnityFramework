      text: "\u0421\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u0435..."
    - language: English
      text: Saving...
  - key: NEXT_SLIDE
    texts:
    - language: Russian
      text: "\u0414\u0430\u043B\u0435\u0435 \u2192"
    - language: English
      text: "Next \u2192"
  - key: CANCEL_COMICS
    texts:
    - language: Russian
