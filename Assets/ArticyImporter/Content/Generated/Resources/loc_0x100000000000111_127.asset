  mLocalizedStringsValues:
  - Codex
  - "\u041A\u043E\u0434\u0435\u043A\u0441 \u0438\u0433\u0440\u043E\u043A\u0430"
  - "\u0411\u0430\u0437\u043E\u0432\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F"
  - "\u041C\u0430\u043B\u043E\u043C\u0435\u0440\u043D\u044B\u0439 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u043A\u043B\u0430\u0441\u0441\u0430
    \u0424\u0440\u0435\u0433\u0430\u0442. \u041C\u043E\u0436\u0435\u0442 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0442\u044C
    \u043C\u0435\u0436\u0437\u0432\u0435\u0437\u0434\u043D\u044B\u0435 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044B.
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F, \u043A\u0430\u043A
    \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u0434\u043B\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C \u0444\u0440\u043E\u043D\u0442\u0438\u0440\u0430."
  - Intro
  - "\u041F\u0435\u0440\u0432\u0430\u044F \u043A\u0430\u0442\u0441\u0446\u0435\u043D\u0430"
  - SpaceShip
  - "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0435
    \u0441\u0443\u0434\u043D\u043E \"\u041F\u0435\u0433\u0430\u0441\""
  - "-\u0410\u0444\u0438\u043D\u0430. \u0421\u0442\u0430\u0442\u0443\u0441."
  - "-\u0412\u0441\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u0432 \u043D\u043E\u0440\u043C\u0435.
    \u0417\u0430\u0440\u044F\u0434\u043A\u0430 \u043A\u043E\u043D\u0434\u0435\u043D\u0441\u0430\u0442\u043E\u0440\u043E\u0432
    \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430. \u041D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u0434\u0430\u043D\u043D\u044B\u0435 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u044B.
    \u041A\u0443\u0440\u0441 \u043F\u0440\u043E\u043B\u043E\u0436\u0435\u043D."
  - "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u043F\u0440\u043E\u0448\u0435\u043B
    \u0432 \u0440\u0443\u0431\u043A\u0443 \u043A\u043E\u0440\u0430\u0431\u043B\u044F
    \u0438 \u0441\u0435\u043B \u0432 \u043A\u0440\u0435\u0441\u043B\u043E \u043F\u0438\u043B\u043E\u0442\u0430.
    \u0449\u0435\u043B\u043A\u043D\u0443\u043B\u0438 \u0444\u0438\u043A\u0441\u0430\u0442\u043E\u0440\u044B.
    \u041A\u043E\u0440\u043E\u0442\u043A\u043E \u043F\u0440\u043E\u0436\u0443\u0436\u0436\u0430\u043B\u0438
    \u043C\u043E\u0442\u043E\u0440\u044B \u043F\u043E\u0434\u0433\u043E\u043D\u044F\u044F
    \u0444\u043E\u0440\u043C\u0443 \u043A\u0440\u0435\u0441\u043B\u0430 \u043F\u043E\u0434
    \u0433\u0430\u0431\u0430\u0440\u0438\u0442\u044B \u043B\u0435\u0433\u043A\u043E\u0433\u043E
    \u0441\u043A\u0430\u0444\u0430\u043D\u0434\u0440\u0430 \u043A\u043E\u0441\u043C\u043E\u043D\u0430\u0432\u0442\u0430."
  - "-\u041F\u043E\u0435\u0445\u0430\u043B\u0438"
  - "-\u0410\u0444\u0438\u043D\u0430. \u041F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B
    \u043F\u0440\u044B\u0436\u043A\u0430."
  - "-\u0426\u0435\u043B\u044C \u043F\u0443\u0442\u0438 \u043A\u043E\u043C\u0435\u0442\u0430
    \u041D\u0438\u043E\u0431\u0430 177. \u041D\u043E\u043C\u0435\u0440 \u043F\u043E
    \u041A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443 \u0418\u043D\u0434\u0435\u043A\u0441\u0443
    557894205857-\u0410\u043B\u044C\u0444\u0430-3-\u041E\u043C\u0435\u0433\u0430.
    \u0420\u0430\u0441\u0441\u0447\u0435\u0442\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
    \u043F\u0440\u044B\u0436\u043A\u0430 27 \u043C\u0438\u043D\u0443\u0442. \u0420\u0430\u0441\u0441\u0447\u0435\u0442\u043D\u044B\u0439
    \u0440\u0430\u0441\u0445\u043E\u0434 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E
    \u0442\u0435\u043B\u0430 44%."
  - "-\u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u043F\u0440\u043E\u0449\u0435 \u043A\u0430\u043A-\u0442\u043E.
    \u0414\u043E\u0431\u0430\u0432\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u043D\u043E\u0441\u0442\u0438
    \u0432 \u0441\u0432\u043E\u0438 \u0448\u0430\u0431\u043B\u043E\u043D\u044B."
  - "-\u0427\u0442\u043E \u0443 \u043D\u0430\u0441 \u0441 \u043F\u0440\u044B\u0436\u043A\u043E\u043C.
    \u0414\u0430\u0439 \u043F\u0440\u043E\u0433\u043D\u043E\u0437\u044B."
  - "-\u0426\u0435\u043B\u044C \u043F\u0443\u0442\u0438 \u043A\u043E\u043C\u0435\u0442\u0430
    \u041D\u0438\u043E\u0431\u0430 177. \u043D\u043E\u043C\u0435\u0440 \u043F\u043E
    \u041A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443 \u0418\u043D\u0434\u0435\u043A\u0441\u0443
    557894205857-\u0410\u043B\u044C\u0444\u0430-3-\u041E\u043C\u0435\u0433\u0430.
    \u041B\u0435\u0442\u0435\u0442\u044C 27 \u043C\u0438\u043D\u0443\u0442. \u041F\u043E\u0442\u0440\u0430\u0442\u0438\u043C
    44% \u0442\u043E\u043F\u043B\u0438\u0432\u0430."
  - "-\u0425\u043E\u0440\u043E\u0448\u043E, \u0448\u0435\u0444. \u041A\u0430\u043A
    \u0441\u043A\u0430\u0436\u0435\u0442\u0435."
  - "-\u0418 \u0434\u0430\u0432\u0430\u0439 \u043D\u0430 \u0442\u044B"
  - "-\u041D\u0430\u0447\u0438\u043D\u0430\u044E \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0443
    \u043F\u0440\u044B\u0436\u043A\u0430. \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C
    10 \u0441\u0435\u043A\u0443\u043D\u0434... 9... 8... 7..."
  - "-\u041D\u0430\u0447\u0438\u043D\u0430\u0435\u043C \u043F\u0440\u044B\u0436\u043E\u043A"
  - 6... 5... 4... 3... 2... 1... 0!
  - "\u041F\u0438\u043B\u043E\u0442 \u0436\u0435\u0441\u0442\u043E\u043C \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442
    \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u044B \u0438 \u0433\u043E\u043B\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u043F\u0430\u043D\u0435\u043B\u0438. \u0423\u0432\u0435\u0440\u0435\u043D\u043D\u043E
    \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u044F \u0440\u0430\u0437\u0434\u0435\u043B\u044B
    \u0438 \u043A\u0430\u0442\u0430\u043B\u043E\u0433\u0438 \u043E\u043D \u043E\u0437\u043D\u0430\u043A\u0430\u043C\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441 \u043A\u043E\u0440\u0430\u0431\u043B\u0435\u043C, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u0435\u043C\u0443 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435."
  - "\u0412 \u043A\u043E\u0434\u0435\u043A\u0441 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u044B
    \u0434\u0430\u043D\u043D\u044B\u0435 \u043E\u0431 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u043C
    \u0441\u0443\u0434\u043D\u0435 \"\u041F\u0435\u0433\u0430\u0441\""
  - MH
  - "\u0413\u043B\u0430\u0432\u043D\u044B\u0439 \u0433\u0435\u0440\u043E\u0439"
