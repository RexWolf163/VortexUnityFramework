  - AI Assistent
  - "\u0418\u0418 \u0410\u0441\u0441\u0438\u0441\u0442\u0435\u043D\u0442"
  - "\u041A\u043E\u0440\u0430\u0431\u0435\u043B\u044C\u043D\u044B\u0439 \u0418\u0441\u043A\u0418\u043D,
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0439
    \u0440\u0430\u0431\u043E\u0442\u0443 \u0441\u0438\u0441\u0442\u0435\u043C \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0433\u043E
    \u0441\u0443\u0434\u043D\u0430 \"\u041F\u0435\u0433\u0430\u0441\"."
  - SpaceShip
  - "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0435
    \u0441\u0443\u0434\u043D\u043E \"\u041F\u0435\u0433\u0430\u0441\""
  - "\u041C\u0430\u043B\u043E\u043C\u0435\u0440\u043D\u044B\u0439 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u043A\u043B\u0430\u0441\u0441\u0430
    \u0424\u0440\u0435\u0433\u0430\u0442. \u041C\u043E\u0436\u0435\u0442 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0442\u044C
    \u043C\u0435\u0436\u0437\u0432\u0435\u0437\u0434\u043D\u044B\u0435 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044B.
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F, \u043A\u0430\u043A
    \u043F\u0440\u0430\u0432\u0438\u043B\u043E, \u0434\u043B\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F
    \u0441\u0438\u0441\u0442\u0435\u043C \u0444\u0440\u043E\u043D\u0442\u0438\u0440\u0430."
  - "\u0417\u0435\u043C\u043D\u0430\u044F \u043E\u0440\u0431\u0438\u0442\u0430"
  - "\u041E\u0440\u0431\u0438\u0442\u0430 \u043A\u043E\u043B\u044B\u0431\u0435\u043B\u0438
    \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u0442\u0432\u0430. \u0415\u0441\u043B\u0438
    \u0435\u0441\u0442\u044C \u0438\u043B\u043B\u044E\u043C\u0438\u043D\u0430\u0442\u043E\u0440\u044B,
    \u043E\u0442\u0441\u044E\u0434\u0430 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0441\u043B\u0430\u0434\u0438\u0442\u044C\u0441\u044F
    \u0432\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u044B\u043C \u0432\u0438\u0434\u043E\u043C
    \u043D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u0443 \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u0440\u0430\u0437\u0443\u043C\u043D\u0430\u044F \u0436\u0438\u0437\u043D\u044C
    \u043D\u0430\u0447\u0430\u043B\u0430 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0442\u044C\u0441\u044F
    \u043F\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443 \u043A\u043E\u0441\u043C\u043E\u0441\u0443."
